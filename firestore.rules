rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public profile settings and resume metadata are readable by all, but only Aslam can write
    match /portfolio_config/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "shaikhaslame0@gmail.com";
    }
    
    // Contact form submissions can be created by visitors; only Aslam can read/manage them
    match /contact_messages/{msgId} {
      allow create: if request.resource.data.email is string 
                    && request.resource.data.name is string 
                    && request.resource.data.message is string;
      allow read, update, delete: if request.auth != null && request.auth.token.email == "shaikhaslame0@gmail.com";
    }
  }
}

